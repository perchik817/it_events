<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="whz.it_events.it_eventsdbapp.controller.MemberController"
            prefWidth="900" prefHeight="500">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <center>
        <VBox styleClass="card" spacing="0" BorderPane.alignment="CENTER">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <BorderPane.margin><Insets right="12"/></BorderPane.margin>
            <TableView fx:id="memberTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colUser" text="User" prefWidth="200"/>
                    <TableColumn fx:id="colTeam" text="Team" prefWidth="200"/>
                    <TableColumn fx:id="colRole" text="Rolle" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </center>
    <right>
        <VBox fx:id="rightPanel" styleClass="card" spacing="12" prefWidth="300" BorderPane.alignment="TOP_CENTER">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <Label text="Member Details" styleClass="title-label"/>
            <Label text="User" styleClass="field-label"/>
            <ComboBox fx:id="userComboBox" maxWidth="Infinity"/>
            <Label text="Team" styleClass="field-label"/>
            <ComboBox fx:id="teamComboBox" maxWidth="Infinity"/>
            <Label text="Team-Rolle" styleClass="field-label"/>
            <TextField fx:id="roleField" promptText="z.B. Leader, Developer"/>
            <HBox spacing="10">
                <Button fx:id="newButton" text="Neu" styleClass="button-secondary" onAction="#onNew"/>
                <Button fx:id="saveButton" text="Speichern" styleClass="button-primary" onAction="#onSave"/>
                <Button fx:id="deleteButton" text="Löschen" styleClass="button-danger" onAction="#onDelete"/>
            </HBox>
            <Label fx:id="statusLabel" wrapText="true" styleClass="status-label"/>
        </VBox>
    </right>
</BorderPane>
