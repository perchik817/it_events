<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="whz.it_events.it_eventsdbapp.controller.LoginController"
           prefWidth="420" prefHeight="520"
           style="-fx-background-color: #F4F6FB;">

    <!-- LOGIN PANEL -->
    <VBox fx:id="loginPanel" alignment="CENTER" spacing="16"
          style="-fx-background-color: #F4F6FB;">
        <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

        <VBox alignment="CENTER" spacing="4">
            <Label text="IT Events"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #5B6EF5;"/>
            <Label text="Verwaltungssystem"
                   style="-fx-font-size: 13px; -fx-text-fill: #8A8FA3;"/>
        </VBox>

        <VBox style="-fx-background-color: white; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, rgba(46,49,66,0.08), 12, 0, 0, 4);"
              spacing="14">
            <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

            <Label text="Anmelden"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2E3142;"/>

            <Label text="E-Mail" styleClass="field-label"/>
            <TextField fx:id="emailField" promptText="name@example.com"/>

            <Label text="Passwort" styleClass="field-label"/>
            <PasswordField fx:id="passwordField" promptText="••••••••"/>

            <Button fx:id="loginButton" text="Einloggen"
                    styleClass="button-primary" maxWidth="Infinity"
                    onAction="#onLogin"/>

            <Label fx:id="errorLabel" wrapText="true" styleClass="status-label"/>

            <VBox alignment="CENTER">
                <Label text="Noch kein Konto?"
                       style="-fx-font-size: 12px; -fx-text-fill: #8A8FA3;"/>
                <Hyperlink text="Jetzt registrieren"
                           onAction="#showRegister"
                           style="-fx-text-fill: #5B6EF5; -fx-font-weight: bold; -fx-font-size: 12px; -fx-border-color: transparent;"/>
            </VBox>
        </VBox>
    </VBox>

    <!-- REGISTER PANEL -->
    <VBox fx:id="registerPanel" alignment="CENTER" spacing="16"
          visible="false" managed="false"
          style="-fx-background-color: #F4F6FB;">
        <padding><Insets top="30" right="40" bottom="30" left="40"/></padding>

        <VBox alignment="CENTER" spacing="4">
            <Label text="IT Events"
                   style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #5B6EF5;"/>
            <Label text="Verwaltungssystem"
                   style="-fx-font-size: 13px; -fx-text-fill: #8A8FA3;"/>
        </VBox>

        <VBox style="-fx-background-color: white; -fx-background-radius: 14; -fx-effect: dropshadow(gaussian, rgba(46,49,66,0.08), 12, 0, 0, 4);"
              spacing="12">
            <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

            <Label text="Registrieren"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2E3142;"/>

            <Label text="Vorname" styleClass="field-label"/>
            <TextField fx:id="regNameField" promptText="Max"/>

            <Label text="Nachname" styleClass="field-label"/>
            <TextField fx:id="regLastnameField" promptText="Mustermann"/>

            <Label text="E-Mail" styleClass="field-label"/>
            <TextField fx:id="regEmailField" promptText="name@example.com"/>

            <Label text="Passwort" styleClass="field-label"/>
            <PasswordField fx:id="regPasswordField" promptText="••••••••"/>

            <Button text="Konto erstellen"
                    styleClass="button-primary" maxWidth="Infinity"
                    onAction="#onRegister"/>

            <Label fx:id="regErrorLabel" wrapText="true" styleClass="status-label"/>

            <VBox alignment="CENTER">
                <Label text="Bereits ein Konto?"
                       style="-fx-font-size: 12px; -fx-text-fill: #8A8FA3;"/>
                <Hyperlink text="Zum Login"
                           onAction="#showLogin"
                           style="-fx-text-fill: #5B6EF5; -fx-font-weight: bold; -fx-font-size: 12px; -fx-border-color: transparent;"/>
            </VBox>
        </VBox>
    </VBox>

</StackPane>
