<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="whz.it_events.it_eventsdbapp.controller.ScoreController"
            prefWidth="1000" prefHeight="550">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <center>
        <VBox styleClass="card" spacing="0" BorderPane.alignment="CENTER">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <BorderPane.margin><Insets right="12"/></BorderPane.margin>
            <TableView fx:id="scoreTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colSubmission" text="Submission" prefWidth="180"/>
                    <TableColumn fx:id="colJury" text="Jury" prefWidth="150"/>
                    <TableColumn fx:id="colCriteria" text="Kriterien" prefWidth="130"/>
                    <TableColumn fx:id="colValue" text="Wert" prefWidth="70"/>
                    <TableColumn fx:id="colComment" text="Kommentar" prefWidth="180"/>
                    <TableColumn fx:id="colDate" text="Datum" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </center>
    <right>
        <VBox styleClass="card" spacing="12" prefWidth="300" BorderPane.alignment="TOP_CENTER">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <Label text="Score Details" styleClass="title-label"/>
            <Label text="Submission" styleClass="field-label"/>
            <ComboBox fx:id="submissionComboBox" maxWidth="Infinity"/>
            <Label text="Jury" styleClass="field-label"/>
            <ComboBox fx:id="juryComboBox" maxWidth="Infinity"/>
            <Label text="Kriterien" styleClass="field-label"/>
            <TextField fx:id="criteriaField" promptText="z.B. Innovation, Design"/>
            <Label text="Wert (0-10)" styleClass="field-label"/>
            <TextField fx:id="valueField" promptText="0-10"/>
            <Label text="Kommentar" styleClass="field-label"/>
            <TextArea fx:id="commentArea" prefRowCount="3" wrapText="true"/>
            <HBox spacing="10">
                <Button fx:id="newButton" text="Neu" styleClass="button-secondary" onAction="#onNew"/>
                <Button fx:id="saveButton" text="Speichern" styleClass="button-primary" onAction="#onSave"/>
                <Button fx:id="deleteButton" text="Löschen" styleClass="button-danger" onAction="#onDelete"/>
            </HBox>
            <Label fx:id="statusLabel" wrapText="true" styleClass="status-label"/>
        </VBox>
    </right>
</BorderPane>
