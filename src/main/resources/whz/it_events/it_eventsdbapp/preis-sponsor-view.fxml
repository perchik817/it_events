<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="whz.it_events.it_eventsdbapp.controller.PreisSponsorController"
            prefWidth="900" prefHeight="500">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
    <center>
        <VBox styleClass="card" spacing="0" BorderPane.alignment="CENTER">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>
            <BorderPane.margin><Insets right="12"/></BorderPane.margin>
            <TableView fx:id="preisSponsorTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colTrack" text="Track" prefWidth="180"/>
                    <TableColumn fx:id="colPreis" text="Preis" prefWidth="180"/>
                    <TableColumn fx:id="colSponsor" text="Sponsor" prefWidth="180"/>
                </columns>
            </TableView>
        </VBox>
    </center>
    <right>
        <VBox fx:id="rightPanel" styleClass="card" spacing="12" prefWidth="300" BorderPane.alignment="TOP_CENTER">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <Label text="PreisSponsor Details" styleClass="title-label"/>
            <Label text="Track" styleClass="field-label"/>
            <ComboBox fx:id="trackComboBox" maxWidth="Infinity"/>
            <Label text="Preis" styleClass="field-label"/>
            <ComboBox fx:id="preisComboBox" maxWidth="Infinity"/>
            <Label text="Sponsor" styleClass="field-label"/>
            <ComboBox fx:id="sponsorComboBox" maxWidth="Infinity"/>
            <HBox spacing="10">
                <Button fx:id="newButton" text="Neu" styleClass="button-secondary" onAction="#onNew"/>
                <Button fx:id="saveButton" text="Speichern" styleClass="button-primary" onAction="#onSave"/>
                <Button fx:id="deleteButton" text="Löschen" styleClass="button-danger" onAction="#onDelete"/>
            </HBox>
            <Label fx:id="statusLabel" wrapText="true" styleClass="status-label"/>
        </VBox>
    </right>
</BorderPane>
