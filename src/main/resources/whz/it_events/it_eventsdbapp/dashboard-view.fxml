<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="whz.it_events.it_eventsdbapp.controller.DashboardController"
            prefWidth="1200" prefHeight="750"
            style="-fx-background-color: #F4F6FB;">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="240"
              style="-fx-background-color: #2E3142; -fx-padding: 0;">

            <VBox alignment="CENTER" style="-fx-padding: 32 24 24 24;">
                <Label text="IT Events"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Verwaltungssystem"
                       style="-fx-font-size: 11px; -fx-text-fill: #8A8FA3;"/>
            </VBox>

            <VBox fx:id="profileCard"
                  style="-fx-background-color: rgba(255,255,255,0.07); -fx-background-radius: 12; -fx-padding: 16;">
                <VBox.margin><Insets left="16" right="16" bottom="16"/></VBox.margin>
                <Label fx:id="userNameLabel"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label fx:id="userRoleLabel"
                       style="-fx-font-size: 11px; -fx-text-fill: #5B6EF5; -fx-font-weight: bold;"/>
                <Label fx:id="userEmailLabel"
                       style="-fx-font-size: 11px; -fx-text-fill: #8A8FA3;"/>
            </VBox>

            <Separator style="-fx-background-color: rgba(255,255,255,0.1);"/>

            <VBox spacing="4" style="-fx-padding: 16 12 16 12;">
                <Button fx:id="btnEvents" text="Events" maxWidth="Infinity"
                        onAction="#showEvents"
                        style="-fx-background-color: #5B6EF5; -fx-text-fill: white; -fx-background-radius: 10; -fx-padding: 12 16; -fx-alignment: CENTER-LEFT; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Button fx:id="btnSessions" text="Meine Sessions" maxWidth="Infinity"
                        onAction="#showSessions"
                        style="-fx-background-color: transparent; -fx-text-fill: #8A8FA3; -fx-background-radius: 10; -fx-padding: 12 16; -fx-alignment: CENTER-LEFT; -fx-cursor: hand;"/>
                <Button fx:id="btnTeams" text="Teams" maxWidth="Infinity"
                        onAction="#showTeams"
                        style="-fx-background-color: transparent; -fx-text-fill: #8A8FA3; -fx-background-radius: 10; -fx-padding: 12 16; -fx-alignment: CENTER-LEFT; -fx-cursor: hand;"/>
                <Button fx:id="btnScores" text="Bewertungen" maxWidth="Infinity"
                        onAction="#showScores"
                        style="-fx-background-color: transparent; -fx-text-fill: #8A8FA3; -fx-background-radius: 10; -fx-padding: 12 16; -fx-alignment: CENTER-LEFT; -fx-cursor: hand;"/>
            </VBox>

            <VBox VBox.vgrow="ALWAYS"/>

            <VBox style="-fx-padding: 16 12;">
                <Separator style="-fx-background-color: rgba(255,255,255,0.1);"/>
                <Button text="← Abmelden" maxWidth="Infinity"
                        onAction="#onLogout"
                        style="-fx-background-color: transparent; -fx-text-fill: #E2574C; -fx-background-radius: 10; -fx-padding: 12 16; -fx-alignment: CENTER-LEFT; -fx-cursor: hand; -fx-font-weight: bold;"/>
            </VBox>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <BorderPane style="-fx-padding: 24;">
            <center>
                <HBox spacing="20">
                    <!-- Left: List -->
                    <VBox prefWidth="380" spacing="16" HBox.hgrow="NEVER">
                        <Label fx:id="contentTitle"
                               text="Events"
                               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2E3142;"/>
                        <ScrollPane fitToWidth="true" fitToHeight="true"
                                    style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;"
                                    VBox.vgrow="ALWAYS">
                            <VBox fx:id="listContainer" spacing="12" style="-fx-padding: 4 4 4 0;"/>
                        </ScrollPane>
                    </VBox>

                    <!-- Right: Universal Detail Panel -->
                    <ScrollPane fx:id="detailPanel" prefWidth="500" HBox.hgrow="ALWAYS"
                                fitToWidth="true"
                                style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent; -fx-background-radius: 16;"
                                visible="false" managed="false">
                        <VBox fx:id="detailContent" spacing="0"
                              style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(gaussian, rgba(46,49,66,0.08), 16, 0, 0, 4);">
                            <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>
                        </VBox>
                    </ScrollPane>
                </HBox>
            </center>
        </BorderPane>
    </center>
</BorderPane>
